<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>deamxhy | Official Site</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,600;0,800;1,400&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0714;
            --bg-card: rgba(22, 13, 38, 0.7);
            --bg-card-hover: rgba(35, 20, 59, 0.85);
            --primary: #9d4edd;
            --primary-glow: rgba(157, 78, 221, 0.5);
            --accent: #c77dff;
            --text-main: #f3e8ff;
            --text-muted: #a78bfa;
            --border-color: rgba(157, 78, 221, 0.2);
            --border-hover: rgba(199, 125, 255, 0.6);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(123, 44, 191, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 85% 85%, rgba(157, 78, 221, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(35, 15, 60, 0.4) 0%, transparent 70%);
            background-attachment: fixed;
            min-height: 100vh;
        }

        /* Header / Navbar */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(11, 7, 20, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 30px;
        }

        .logo {
            font-family: 'Syne', sans-serif;
            font-size: 1.8rem;
            font-weight: 800;
            color: #fff;
            text-decoration: none;
            letter-spacing: 1px;
            text-shadow: 0 0 15px var(--primary-glow);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo span {
            color: var(--accent);
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: color 0.3s, text-shadow 0.3s;
        }

        .nav-links a:hover {
            color: var(--text-main);
            text-shadow: 0 0 10px var(--accent);
        }

        .social-nav {
            display: flex;
            gap: 15px;
        }

        .social-nav a {
            color: var(--text-muted);
            font-size: 1.1rem;
            transition: color 0.3s, transform 0.3s;
        }

        .social-nav a:hover {
            color: var(--accent);
            transform: translateY(-2px);
        }

        /* Hero Section */
        .hero {
            min-height: 90vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 140px 20px 60px;
            position: relative;
        }

        .hero-content {
            max-width: 800px;
            z-index: 2;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(157, 78, 221, 0.15);
            border: 1px solid var(--border-color);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 25px;
            box-shadow: 0 0 20px rgba(157, 78, 221, 0.2);
        }

        .hero h1 {
            font-family: 'Syne', sans-serif;
            font-size: clamp(3rem, 7vw, 6rem);
            font-weight: 800;
            margin-bottom: 20px;
            letter-spacing: -1px;
            background: linear-gradient(135deg, #ffffff 30%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 10px 40px rgba(157, 78, 221, 0.3);
        }

        .hero p {
            font-size: 1.15rem;
            color: var(--text-muted);
            margin-bottom: 40px;
            line-height: 1.6;
        }

        .hero-btns {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 32px;
            border-radius: 30px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            cursor: pointer;
            font-size: 0.95rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), #7b2cbf);
            color: white;
            border: none;
            box-shadow: 0 0 25px rgba(157, 78, 221, 0.5);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 35px rgba(199, 125, 255, 0.8);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-main);
            border: 1px solid var(--border-color);
            backdrop-filter: blur(5px);
        }

        .btn-outline:hover {
            border-color: var(--accent);
            background: rgba(157, 78, 221, 0.1);
            transform: translateY(-3px);
        }

        /* Container & Sections */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 60px 30px;
        }

        .section-title {
            font-family: 'Syne', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 15px;
            text-align: center;
        }

        .section-subtitle {
            text-align: center;
            color: var(--text-muted);
            margin-bottom: 40px;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* SoundCloud Embed Player Wrapper */
        .sc-player-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 20px;
            backdrop-filter: blur(15px);
            margin-bottom: 80px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
            overflow: hidden;
        }

        .sc-player-container iframe {
            width: 100%;
            height: 450px;
            border: none;
            border-radius: 12px;
        }

        /* Discography Grid */
        .releases-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 30px;
        }

        .release-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .release-card:hover {
            transform: translateY(-8px);
            border-color: var(--border-hover);
            background: var(--bg-card-hover);
            box-shadow: 0 15px 35px rgba(157, 78, 221, 0.25);
        }

        .release-img-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 1;
            overflow: hidden;
        }

        .release-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .release-card:hover .release-img-wrap img {
            transform: scale(1.08);
        }

        .release-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(11, 7, 20, 0.8);
            backdrop-filter: blur(5px);
            border: 1px solid var(--border-color);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--accent);
            text-transform: uppercase;
        }

        .release-info {
            padding: 20px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            justify-content: space-between;
        }

        .release-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 5px;
            color: #fff;
        }

        .release-meta {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 15px;
        }

        .release-btn {
            display: block;
            background: rgba(157, 78, 221, 0.1);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.2s;
        }

        .release-btn:hover {
            background: var(--primary);
            border-color: var(--accent);
            color: #fff;
        }

        /* About Section */
        .about-section {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 50px;
            backdrop-filter: blur(15px);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
            margin-top: 40px;
        }

        @media(max-width: 900px) {
            .about-section {
                grid-template-columns: 1fr;
                padding: 30px;
            }
        }

        .about-text h3 {
            font-family: 'Syne', sans-serif;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: #fff;
        }

        .about-text p {
            color: var(--text-muted);
            line-height: 1.8;
            margin-bottom: 20px;
        }

        /* Footer */
        footer {
            border-top: 1px solid var(--border-color);
            background: rgba(11, 7, 20, 0.95);
            padding: 40px 30px;
            text-align: center;
            margin-top: 80px;
        }

        .footer-logo {
            font-family: 'Syne', sans-serif;
            font-size: 1.8rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 15px;
        }

        .footer-socials {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .footer-socials a {
            color: var(--text-muted);
            font-size: 1.3rem;
            transition: color 0.3s;
        }

        .footer-socials a:hover {
            color: var(--accent);
        }

        .copyright {
            color: var(--text-muted);
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="nav-container">
