    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-logo">DEAMXHY</div>
        <div class="footer-socials">
            <a href="https://soundcloud.com" target="_blank"><i class="fa-brands fa-soundcloud"></i></a>
